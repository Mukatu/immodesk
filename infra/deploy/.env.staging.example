# =====================================================================
# Immodesk — variables de la pile de recette (staging).
#
# Sur le serveur : cp .env.staging.example .env && chmod 600 .env
# puis remplacer chaque valeur vide. Ce fichier d'exemple ne contient AUCUN
# secret ; le fichier .env, lui, n'est jamais versionné (.gitignore).
#
# Générer chaque secret avec :   openssl rand -hex 32
# (64 caractères hexadécimaux : sans caractère spécial, donc sans souci dans
# les URL de connexion). Un secret différent par ligne, jamais réutilisé.
# =====================================================================

# --- Environnement ---------------------------------------------------
# `staging` : messagerie simulée autorisée (codes de connexion dans le
# journal de l'API, docs/10_deploiement.md § 9). Passer à `production` le
# jour où WhatsApp (C1) et la passerelle SMS (E1) sont branchés.
DEPLOYMENT_ENV=staging

# --- Adresses publiques (enregistrements DNS A/AAAA vers le serveur) ---
# En recette, chaque hôte doit contenir le libellé « staging » : l'API refuse
# de démarrer sinon.
WEB_HOST=staging.immodesk.watuneed.fr
API_HOST=api.staging.immodesk.watuneed.fr
S3_HOST=s3.staging.immodesk.watuneed.fr
# Adresse de contact Let's Encrypt (avis d'expiration des certificats).
ACME_EMAIL=

# --- PostgreSQL --------------------------------------------------------
# Propriétaire du schéma (superutilisateur) : migrations et sauvegardes
# uniquement, jamais transmis à l'API.            openssl rand -hex 32
POSTGRES_PASSWORD=
# Rôle de l'API, soumis à la RLS.                 openssl rand -hex 32
IMMODESK_APP_PASSWORD=
# Rôle des tâches transverses (BYPASSRLS, non superutilisateur).
#                                                  openssl rand -hex 32
IMMODESK_ADMIN_PASSWORD=

# --- Redis ---------------------------------------------------------------
#                                                  openssl rand -hex 32
REDIS_PASSWORD=

# --- MinIO (stockage des photos, signatures et PDF) ----------------------
# Compte administrateur de MinIO : sert seulement à minio-init.
MINIO_ROOT_USER=immodesk-root
#                                                  openssl rand -hex 32
MINIO_ROOT_PASSWORD=
# Compte de l'API, limité au bucket « immodesk » (créé par minio-init).
S3_ACCESS_KEY=immodesk-api
#                                                  openssl rand -hex 32
S3_SECRET_KEY=

# --- Secrets de l'API ----------------------------------------------------
# Tous obligatoires : l'API refuse les valeurs de développement.
#                                                  openssl rand -hex 32
JWT_ACCESS_SECRET=
CURSOR_SECRET=
OTP_PEPPER=
LINK_SIGNING_SECRET=
MOMO_SIMULATOR_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SMS_GATEWAY_WEBHOOK_SECRET=

# --- Messagerie ----------------------------------------------------------
# `fake` : rien n'est envoyé, le message (et le code) est écrit dans le
# journal de l'API. Interdit dès que DEPLOYMENT_ENV=production.
WHATSAPP_PROVIDER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER=fake
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# --- Mobile Money --------------------------------------------------------
# Le simulateur est interdit sur un serveur public. Sans clé OpenPay, le
# mode agrégateur répond une erreur ; le mode « paiement déclaré » marche.
MOMO_PROVIDER_DEFAULT=OPENPAY
OPENPAY_API_KEY=
# Segment secret de l'URL de rappel (au moins 32 caractères A-Z a-z 0-9 _ -).
#                                                  openssl rand -hex 32
OPENPAY_CALLBACK_SECRET=
# IP sources d'OpenPay, séparées par des virgules (vide : pas de filtrage).
OPENPAY_CALLBACK_IP_ALLOWLIST=

# --- Divers ----------------------------------------------------------------
LOG_LEVEL=info
# Documentation interactive de l'API (/v1/docs) : désactivée par défaut.
SWAGGER_ENABLED=false
PRIVACY_DPO_CONTACT=
# Réseau Docker partagé avec Caddy (et les autres projets du serveur).
EDGE_NETWORK=watuneed_edge
# Dossier des fichiers d'hôtes Caddy (un par projet). Voir docs/10 § 11.
CADDY_SITES_DIR=./caddy/sites
