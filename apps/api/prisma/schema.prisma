  processing_attempts       Int                         @default(0) @db.SmallInt
  error_message             String?
  related_entity_type       String?
  related_entity_id         String?                     @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  mobile_money_transactions mobile_money_transactions[]
  organizations             organizations?              @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([source, external_event_id], map: "webhook_events_external_uk")
  @@index([organization_id, source, received_at(sort: Desc)], map: "webhook_events_org_idx")
