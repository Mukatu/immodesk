# =====================================================================
# @immodesk/api — variables d'environnement
# Copiez ce fichier en `.env` puis ajustez. Toutes les variables sont
# validées au démarrage par zod (src/shared/config/config.schema.ts) :
# une valeur manquante ou incohérente empêche le boot.
# =====================================================================

NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=v1
LOG_LEVEL=debug

# --- PostgreSQL ------------------------------------------------------
# Rôle applicatif : soumis aux policies RLS (ni SUPERUSER ni BYPASSRLS).
# C'est la connexion utilisée par tout le code métier.
# Port hôte 5440 : voir infra/docker/docker-compose.yml.
DATABASE_URL=postgresql://immodesk_app:immodesk_app@localhost:5440/immodesk

# Rôle d'administration (BYPASSRLS). Utilisé par les migrations Prisma, le
# seed, et — côté runtime — uniquement par TenantDirectoryService pour les
# trois lectures transverses aux organisations (liste des adhésions d'un
# utilisateur, résolution d'une invitation par jeton, unicité d'un slug).
DATABASE_ADMIN_URL=postgresql://immodesk:immodesk@localhost:5440/immodesk

# --- Redis (limitation de débit) -------------------------------------
REDIS_URL=redis://localhost:6390

# --- Stockage objet compatible S3 (MinIO en local) -------------------
# Les pièces jointes ne transitent jamais par l'API : le client envoie et
# télécharge par URL signée. Console MinIO locale sur http://localhost:9011.
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=immodesk
S3_ACCESS_KEY=immodesk
S3_SECRET_KEY=immodesk123
# MinIO ignore la région, mais le SDK AWS en exige une pour signer.
S3_REGION=us-east-1
# Validité de l'URL d'ENVOI. Le téléchargement est figé à 10 min par le contrat.
S3_UPLOAD_URL_TTL_SECONDS=600

# --- Purge différée des documents supprimés ---------------------------
# La suppression d'un document est logique ; l'objet stocké est détruit
# après le délai de rétractation par DocumentPurgeService.
DOCUMENTS_PURGE_ENABLED=true
DOCUMENTS_PURGE_INTERVAL_SECONDS=3600
DOCUMENTS_PURGE_GRACE_HOURS=24
DOCUMENTS_PURGE_BATCH_SIZE=50

# --- Jetons ----------------------------------------------------------
# HS256 (secret partagé) en local ; RS256 (paire de clés) en déploiement.
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=immodesk-dev-access-secret-change-me
# Pour RS256, renseigner à la place (PEM sur une ligne, \n échappés) :
# JWT_ACCESS_PRIVATE_KEY=
# JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=immodesk
JWT_AUDIENCE=immodesk-api
REFRESH_TOKEN_TTL_DAYS=30

# Clé de signature des curseurs de pagination (empêche de forger une position).
CURSOR_SECRET=immodesk-dev-cursor-secret-change-me

# --- OTP -------------------------------------------------------------
# Poivre du hachage SHA-256 des codes : vit hors base, à régénérer par
# environnement. Une copie de `otp_codes` sans lui est inexploitable.
OTP_PEPPER=immodesk-dev-otp-pepper
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER_SECONDS=60
OTP_CODE_LENGTH=6
# Code fixe accepté en développement. Refusé au démarrage si NODE_ENV=production.
OTP_DEV_CODE=000000

# --- Limitation de débit sur /v1/auth/otp/request ---------------------
RATE_LIMIT_OTP_PER_PHONE=3
RATE_LIMIT_OTP_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_PER_IP=20
RATE_LIMIT_OTP_IP_WINDOW_SECONDS=3600

# --- Invitations -----------------------------------------------------
INVITATION_TTL_DAYS=7
INVITATION_BASE_URL=https://app.immodesk.cg/invitations

# --- Messagerie ------------------------------------------------------
# `fake` : aucun envoi réel, le code est journalisé. Seule valeur en phase 0.
SMS_PROVIDER=fake
WHATSAPP_PROVIDER=fake

# --- Observabilité ---------------------------------------------------
SENTRY_DSN=
SWAGGER_ENABLED=true

# --- Files BullMQ (phase 2) -------------------------------------------
# Préfixe des clés Redis : deux environnements partageant un Redis ne
# doivent jamais se voler un job.
QUEUE_PREFIX=immodesk

# Cron quotidien des baux : préavis échus, expirations et reconductions,
# révisions de loyer devenues effectives. 02:00, heure de Brazzaville.
LEASES_CRON_ENABLED=true
LEASES_CRON_PATTERN=0 2 * * *
LEASES_CRON_TIMEZONE=Africa/Brazzaville

# --- Worker PDF (Puppeteer, phase 2) ----------------------------------
PDF_WORKER_ENABLED=true
# Deux rendus simultanés : au delà, Chromium consomme plus de mémoire que
# le VPS n'en a (risque identifié au plan de phases, § 2.10).
PDF_WORKER_CONCURRENCY=2
PDF_JOB_TIMEOUT_MS=60000
PDF_JOB_ATTEMPTS=3
# Navigateur de rendu. À renseigner quand le Chromium empaqueté par
# Puppeteer n'a pas été téléchargé (politique de build, réseau fermé) :
# l'API se replie alors sur un Chrome ou un Edge déjà installé, mais un
# chemin explicite lève toute ambiguïté. Exemples :
#   Windows : C:\Program Files\Google\Chrome\Application\chrome.exe
#   Debian  : /usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=
# Arguments de lancement, séparés par des virgules (utiles en conteneur).
PUPPETEER_LAUNCH_ARGS=--no-sandbox,--disable-dev-shm-usage
