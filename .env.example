# Base de données PostgreSQL — rôle applicatif (soumis aux policies RLS),
# utilisé par le backend au runtime.
DATABASE_URL=postgresql://immodesk_app:immodesk_app@localhost:5440/immodesk

# Base de données PostgreSQL — rôle admin/owner (BYPASSRLS via immodesk_admin
# côté schéma applicatif, propriétaire des objets côté immodesk), réservé aux
# migrations et scripts d'administration.
DATABASE_ADMIN_URL=postgresql://immodesk:immodesk@localhost:5440/immodesk

# Cache / files d'attente Redis.
REDIS_URL=redis://localhost:6390

# Stockage objet compatible S3 (MinIO en local).
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=immodesk
S3_ACCESS_KEY=immodesk
S3_SECRET_KEY=immodesk123

# Secrets JWT (access/refresh) — à régénérer avant tout déploiement réel.
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

# Code OTP fixe utilisé en développement (bypass de l'envoi SMS réel).
OTP_DEV_CODE=000000

# Fournisseur SMS ("fake" en local : les envois sont journalisés, pas réels).
SMS_PROVIDER=fake

# DSN Sentry pour le suivi d'erreurs (laisser vide en développement).
SENTRY_DSN=

# URL publique de l'API consommée par les clients front-end.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1
