# Variables consommées directement par infra/docker/docker-compose.yml.
# Les valeurs par défaut inline du docker-compose.yml sont déjà identiques
# à celles-ci : ce fichier n'est nécessaire que si vous voulez lancer la
# pile avec --env-file infra/env/docker.env.example, par ex. :
#   docker compose -f infra/docker/docker-compose.yml --env-file infra/env/docker.env.example up -d

# PostgreSQL — base et rôle admin/owner créés par l'image officielle.
POSTGRES_DB=immodesk
POSTGRES_USER=immodesk
POSTGRES_PASSWORD=immodesk

# PostgreSQL — mot de passe attribué au rôle applicatif immodesk_app
# (créé NOLOGIN par docs/schema/schema.sql, puis activé par
# infra/docker/init/01-schema.sh).
IMMODESK_APP_PASSWORD=immodesk_app

# MinIO (stockage S3 local).
MINIO_ROOT_USER=immodesk
MINIO_ROOT_PASSWORD=immodesk123
