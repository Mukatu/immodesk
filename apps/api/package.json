{
  "name": "@immodesk/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Immodesk — NestJS, Clean Architecture, multi-tenant PostgreSQL RLS.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.unit.config.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.unit.config.js --watch",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:resolve": "prisma migrate resolve --applied 0_init",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "~12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "~12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "~12.2.0",
    "@nestjs/swagger": "~12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.3.0",
    "bullmq": "^6.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "handlebars": "^4.7.10",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "~12.0.10",
    "@nestjs/schematics": "~12.0.10",
    "@nestjs/testing": "~12.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.18.0",
    "jest": "^30.5.2",
    "jsqr": "^1.4.0",
    "pino-pretty": "^13.2.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.3.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
